# Copie para a Vercel em Settings > Environment Variables (não coloque a chave no código)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo e limites
LESSY_MODEL=claude-sonnet-5
LESSY_MAX_SESSAO=3
LESSY_MAX_IP=20
LESSY_MAX_DIA=400

# Criadas automaticamente ao conectar o Upstash (Redis) pela Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=
